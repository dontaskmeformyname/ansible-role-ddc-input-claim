#!/usr/bin/env bash
set -u

GATE=/usr/local/libexec/ddc-input-gates
DDC=/usr/bin/ddcutil
RETRIES={{ ddc_claim_retries | int }}
DELAY={{ ddc_claim_retry_delay | int }}

log() { /usr/bin/logger -t ddc-input-claim -- "$*"; }

force=false
case "${1:-}" in
    "") ;;
    --force) force=true ;;
    *) echo "Usage: $0 [--force]" >&2; exit 2 ;;
esac

if ! "$force" && ! "$GATE" check; then
    log "Gates nicht erfuellt; Claim wird uebersprungen"
    exit 0
fi

for attempt in $(/usr/bin/seq 1 "$RETRIES"); do
    failed=0
    {% for action in ddc_claim_actions %}
    if ! "$DDC" setvcp {{ action.feature | quote }} {{ action.value | quote }} --bus {{ action.bus | quote }} --noverify; then
        log "DDC fehlgeschlagen: bus={{ action.bus }}, feature={{ action.feature }}, value={{ action.value }}, Versuch=$attempt"
        failed=1
    fi
    {% endfor %}
    if [ "$failed" -eq 0 ]; then
        log "DDC-Claim erfolgreich (Versuch $attempt)"
        exit 0
    fi
    [ "$attempt" -lt "$RETRIES" ] && /usr/bin/sleep "$DELAY"
done

# Absichtlich 0: Ein ausgeschalteter/noch nicht erreichbarer Monitor degradiert den Boot nicht.
log "DDC-Claim nach $RETRIES Versuchen nicht vollstaendig; wird nicht als Servicefehler behandelt"
exit 0
